# Reference only — do not put secrets here.
# Copy the keys below into `.env` and fill in your values.
#
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[URL-ENCODED-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
# DATABASE_POOL_MAX=2
# API_GATEWAY_URL=http://localhost:4000
# JWT_SECRET=<long-random-string>
# JWT_EXPIRES_IN=7d
#
# Seed identity (required for pnpm db:seed)
# STATE_ADMIN_EMAIL=
# STATE_ADMIN_PASSWORD=
# STATE_ADMIN_FULL_NAME=State Administrator
# SEED_ACADEMY_ADMIN_EMAIL=
# SEED_ACADEMY_ADMIN_PASSWORD=
# SEED_ACADEMY_ADMIN_FULL_NAME=Academy Administrator
#
# Optional service ports (defaults shown):
# GATEWAY_PORT=4000
# ACADEMY_SERVICE_PORT=4001
# PEOPLE_SERVICE_PORT=4002
# OPERATIONS_SERVICE_PORT=4003
# COMPETITIONS_SERVICE_PORT=4004
# INVENTORY_SERVICE_PORT=4005
# PAYROLL_SERVICE_PORT=4006
